{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-msse4.1",
        "CMAKE_CXX_FLAGS": "-msse4.1",
        "PINYON_SHIFT_CPU_BASELINE": "sse4.1",
        "REXSDK_DIR": "${sourceDir}/thirdparty/shiftglue-sdk",
        "REXGLUE_USE_VULKAN": "ON",
        "PINYON_SHIFT_GENERATED_ROOT": "${sourceDir}/.local/generated",
        "PINYON_SHIFT_GENERATED_DIR": "${sourceDir}/.local/generated/default"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86_64-sniper.cmake",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-msse4.1",
        "CMAKE_CXX_FLAGS": "-msse4.1",
        "PINYON_SHIFT_CPU_BASELINE": "sse4.1",
        "REXSDK_DIR": "${sourceDir}/thirdparty/shiftglue-sdk",
        "PINYON_SHIFT_GENERATED_ROOT": "${sourceDir}/.local/generated",
        "PINYON_SHIFT_GENERATED_DIR": "${sourceDir}/.local/generated/default"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-amd64-debug",
      "displayName": "Windows AMD64 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "displayName": "Windows AMD64 RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "win-amd64-release",
      "displayName": "Windows AMD64 Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-amd64-v4",
      "displayName": "Windows AMD64 Release, FH1 v4 title update",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PINYON_SHIFT_TITLE_UPDATE_V4": "ON",
        "PINYON_SHIFT_MANIFEST": "${sourceDir}/config/rexglue/pinyon_shift_v4_manifest.toml",
        "PINYON_SHIFT_GENERATED_ROOT": "${sourceDir}/.local/generated-v4",
        "PINYON_SHIFT_GENERATED_DIR": "${sourceDir}/.local/generated-v4/default"
      }
    },
    {
      "name": "linux-amd64-debug",
      "displayName": "Linux AMD64 Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "displayName": "Linux AMD64 RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-amd64-release",
      "displayName": "Linux AMD64 Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-33",
        "ANDROID_STL": "c++_shared",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-z,max-page-size=16384",
        "PINYON_SHIFT_CPU_BASELINE": "armv8-a",
        "REXSDK_DIR": "${sourceDir}/thirdparty/shiftglue-sdk",
        "REXGLUE_USE_VULKAN": "ON",
        "PINYON_SHIFT_GENERATED_ROOT": "${sourceDir}/.local/generated",
        "PINYON_SHIFT_GENERATED_DIR": "${sourceDir}/.local/generated/default"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android ARM64 Debug",
      "inherits": "android-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "android-arm64-relwithdebinfo",
      "displayName": "Android ARM64 RelWithDebInfo",
      "inherits": "android-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android ARM64 Release",
      "inherits": "android-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-arm64-v4",
      "displayName": "Android ARM64 Release, FH1 v4 title update",
      "inherits": "android-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PINYON_SHIFT_TITLE_UPDATE_V4": "ON",
        "PINYON_SHIFT_MANIFEST": "${sourceDir}/config/rexglue/pinyon_shift_v4_manifest.toml",
        "PINYON_SHIFT_GENERATED_ROOT": "${sourceDir}/.local/generated-v4",
        "PINYON_SHIFT_GENERATED_DIR": "${sourceDir}/.local/generated-v4/default"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-debug",
      "configurePreset": "win-amd64-debug"
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "configurePreset": "win-amd64-relwithdebinfo"
    },
    {
      "name": "win-amd64-release",
      "configurePreset": "win-amd64-release"
    },
    {
      "name": "win-amd64-v4",
      "configurePreset": "win-amd64-v4"
    },
    {
      "name": "linux-amd64-debug",
      "configurePreset": "linux-amd64-debug"
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "configurePreset": "linux-amd64-relwithdebinfo"
    },
    {
      "name": "linux-amd64-release",
      "configurePreset": "linux-amd64-release"
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64-debug"
    },
    {
      "name": "android-arm64-relwithdebinfo",
      "configurePreset": "android-arm64-relwithdebinfo"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release"
    },
    {
      "name": "android-arm64-v4",
      "configurePreset": "android-arm64-v4"
    }
  ]
}
