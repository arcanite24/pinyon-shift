+TEST_CASE("TemplateRegistry: init_cpp maps resumable return aliases for the entrypoint image",
+          "[TemplateRegistry][resume]") {
+  rex::codegen::TemplateRegistry registry;
+  std::string json = R"({
+    "project": "test_proj",
+    "image_base": "0x82000000",
+    "image_size": "0x1000000",
+    "code_base": "0x82010000",
+    "code_size": "0x100000",
+    "rexcrt_heap": 0,
+    "has_dll_modules": false,
+    "is_dll": false,
+    "functions": [{
+      "address": "0x82010000",
+      "name": "sub_82010000",
+      "below_code_base": false,
+      "is_import": false,
+      "resume_aliases": ["0x82010004", "0x82010010"]
+    }]
+  })";
+  std::string result = registry.render("codegen/init_cpp", json);
+  CHECK(result.find("{ 0x82010000, sub_82010000 }") != std::string::npos);
+  CHECK(result.find("{ 0x82010004, sub_82010000 }") != std::string::npos);
+  CHECK(result.find("{ 0x82010010, sub_82010000 }") != std::string::npos);
+}
