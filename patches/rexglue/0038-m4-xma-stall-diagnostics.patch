+      "buffer {}, input {} -> {}, output {}/{}",
+      id(), previous.consecutive_no_space_stalls,
+      previous.consecutive_no_progress_stalls, data.current_buffer,
+      previous_input_offset, data.input_buffer_read_offset,
+      data.output_buffer_read_offset, output_write_offset);
