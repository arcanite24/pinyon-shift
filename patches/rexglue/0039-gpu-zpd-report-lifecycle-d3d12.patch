+ZPDMode D3D12CommandProcessor::GetZPDMode() const {
+  const std::string& mode = REXCVAR_GET(occlusion_query);
+  if (mode == "fake") {
+    return ZPDMode::kFake;
+  }
+  if (mode == "fast") {
+    return ZPDMode::kFast;
+  }
+  if (mode == "strict") {
+    return ZPDMode::kStrict;
+  }
+  return ZPDMode::kLegacy;
+}
