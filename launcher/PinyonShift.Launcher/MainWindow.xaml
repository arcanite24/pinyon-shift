<Window x:Class="PinyonShift.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinyon Shift" Width="1080" Height="720" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InkBrush}"
        Foreground="{StaticResource FogBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#131713" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="38,34,34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="PINYON" FontFamily="Bahnschrift Condensed" FontWeight="SemiBold"
                               FontSize="42"/>
                    <TextBlock Text="SHIFT" FontFamily="Bahnschrift Condensed" FontWeight="Light"
                               FontSize="42" Margin="0,-11,0,0" Foreground="{StaticResource AmberBrush}"/>
                    <Border Width="56" Height="3" Background="{StaticResource AmberBrush}"
                            HorizontalAlignment="Left" Margin="1,18,0,0"/>
                    <TextBlock Text="W I N D O W S   P L A Y A B L E   P R E V I E W" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="1,15,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,38,0,24" TextWrapping="Wrap" LineHeight="22"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Your game stays yours. This launcher verifies your disc image, builds the native translation on this PC, and keeps every generated file local."/>

                <ItemsControl Grid.Row="2" x:Name="RouteList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="2" Width="22" Height="22" CornerRadius="11"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{Binding Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Unofficial community project" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Not affiliated with Microsoft or Playground Games" FontSize="10"
                               Foreground="#747B74" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="48,40,48,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="EyebrowText" Text="READY FOR YOUR DISC" Foreground="{StaticResource AmberBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeadlineText" Text="Build your preview." FontFamily="Bahnschrift SemiCondensed"
                               FontSize="34" FontWeight="SemiBold" Margin="0,7,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource PanelBrush}" CornerRadius="18"
                        Padding="12,7" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="SYSTEM READY" FontSize="10"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="22" Margin="0,30,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FORZA HORIZON DISC IMAGE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="IsoPathTextBox" Margin="0,10,14,0" IsReadOnly="True"
                                 ToolTip="Select your personally dumped supported Xbox 360 disc image."/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowseButton" Content="CHOOSE ISO" Style="{StaticResource QuietButton}"
                            VerticalAlignment="Bottom" Click="BrowseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,15" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SUPPORTED INPUT" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="USA retail · MS-2505" FontSize="14" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,15" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="LOCAL BUILD" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="BuildLocationText" Text="%LOCALAPPDATA%\PinyonShift" FontSize="14" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" x:Name="LogPanel" Background="#0B0E0B" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="5" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="17,13">
                        <TextBlock Text="BUILD LOG" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Text="0%" FontSize="10"
                                   Foreground="{StaticResource AmberBrush}"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="LogTextBox" BorderThickness="0" Background="Transparent"
                             FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Padding="17,0,17,15"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="OwnershipCheckBox" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                          FontFamily="Bahnschrift" FontSize="12" Checked="InputChanged" Unchecked="InputChanged">
                    <TextBlock Text="I own this copy and dumped it from my own disc." TextWrapping="Wrap"/>
                </CheckBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenLogsButton" Content="OPEN LOGS" Style="{StaticResource QuietButton}"
                            Visibility="Collapsed" Margin="0,0,12,0" Click="OpenLogsButton_Click"/>
                    <Button x:Name="PrimaryButton" Content="VERIFY &amp; BUILD" Style="{StaticResource ActionButton}"
                            MinWidth="180" IsEnabled="False" Click="PrimaryButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
