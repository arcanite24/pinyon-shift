<Window x:Class="PinyonShift.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinyon Shift" Width="1120" Height="720" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InkBrush}"
        Foreground="{StaticResource FogBrush}" Icon="Branding/pinyon-shift.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Art behind the title bar and the body; the ridges are the horizon. -->
            <Grid Grid.RowSpan="2" ClipToBounds="True">
                <Border Background="{StaticResource HeroGradient}"/>
                <!-- In a zero-size canvas, so the art never sizes the rows it spans. -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                    <Image Source="Branding/mark-light.png" Height="400" Opacity="0.05"
                           Canvas.Left="-470" Canvas.Top="0" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Canvas>
                <Path VerticalAlignment="Bottom" Height="170" Stretch="Fill" Opacity="0.55"
                      Data="M0,150 L0,96 L70,62 L120,84 L190,40 L260,78 L330,52 L400,86 L470,48 L560,82 L630,58 L720,90 L800,50 L880,80 L960,44 L1040,76 L1120,54 L1180,70 L1180,150 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E4A30" Offset="0"/>
                            <GradientStop Color="#0A0F0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path VerticalAlignment="Bottom" Height="100" Stretch="Fill" Opacity="0.9"
                      Data="M0,92 L0,64 L40,44 L60,56 L90,30 L120,52 L170,38 L230,60 L290,34 L340,56 L400,42 L470,66 L540,36 L600,58 L660,44 L740,64 L820,32 L880,54 L950,40 L1020,62 L1090,38 L1140,52 L1180,44 L1180,92 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#123321" Offset="0"/>
                            <GradientStop Color="#0A0F0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Grid>

            <!-- Title bar. -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="Branding/logo-light.png" Height="22" Margin="28,0,0,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Click="MaximizeButton_Click" AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Body: the state in one headline, one line of detail, the action,
                 and a panel when there is something to do here. -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="56,0,56,36">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeadlineText" Text="Build your preview"
                           FontFamily="Bahnschrift SemiBold" FontSize="44"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Row="1" x:Name="SubheadText" MaxWidth="640" HorizontalAlignment="Left"
                           TextWrapping="Wrap" LineHeight="22" FontSize="15" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0" Text="Verified, extracted and compiled on this PC. Nothing is uploaded."/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="200"
                            IsEnabled="False" Click="PrimaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PrimaryIcon" Data="M0,0 L0,14 L11,7 Z" Fill="{StaticResource InkBrush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="PrimaryButtonText" Text="Verify and build"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontFamily="Bahnschrift SemiBold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GraphicsSettingsButton" Content="Settings" Style="{StaticResource QuietButton}"
                            Height="54" Padding="24,0" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="GraphicsSettingsButton_Click"
                            AutomationProperties.HelpText="Choose the resolution, output scaling and the Treasure Map."/>
                    <Button x:Name="AndroidButton" Content="Android" Style="{StaticResource QuietButton}"
                            Height="54" Padding="24,0" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="AndroidButton_Click"
                            AutomationProperties.HelpText="Build the game for your Android device and install it over Wi-Fi."/>
                    <Button x:Name="DlcButton" Content="DLC" Style="{StaticResource QuietButton}"
                            Height="54" Padding="20,0" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="DlcButton_Click" AutomationProperties.HelpText="Import and manage your owned downloadable content."/>
                </StackPanel>

                <!-- Setup steps, while there is setup left to do. -->
                <ItemsControl Grid.Row="3" x:Name="RouteList" Margin="0,30,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Height="3" CornerRadius="1.5" Background="{Binding Brush}"/>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Margin="0,32,0,0">

                <!-- Setup: the disc image. -->
                <Border x:Name="SetupPanel" CornerRadius="14" Padding="26,22" VerticalAlignment="Top"
                        Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14" Margin="-26,-22"
                                   Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                                   StrokeDashArray="5 4" IsHitTestVisible="False"/>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="BrowseFolderButton" Content="Choose extracted folder"
                                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BrowseFolderButton_Click"/>
                                <Button DockPanel.Dock="Right" x:Name="BrowseButton" Content="Choose ISO"
                                        Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                                        Click="BrowseButton_Click"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="DropHintText" Text="Drop your Forza Horizon ISO or extracted folder"
                                               FontSize="17" FontFamily="Bahnschrift SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="The USA retail disc (MS-2505), dumped from your own copy."
                                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBox x:Name="IsoPathTextBox" Margin="0,16,0,0" IsReadOnly="True" Visibility="Collapsed"
                                     AutomationProperties.Name="Disc image"/>
                            <CheckBox x:Name="OwnershipCheckBox" Margin="0,18,0,0"
                                      FontFamily="Bahnschrift" FontSize="13" Checked="InputChanged" Unchecked="InputChanged">
                                <TextBlock Text="I own this copy and dumped it from my own disc." TextWrapping="Wrap"
                                           Foreground="{StaticResource FogBrush}"/>
                            </CheckBox>
                            <DockPanel Margin="0,18,0,0">
                                <Button DockPanel.Dock="Right" x:Name="ChooseInstallRootButton" Content="Change"
                                        IsEnabled="False" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Click="ChooseInstallRootButton_Click"
                                        ToolTip="Existing files and saves stay where they are."/>
                                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run x:Name="BuildLocationPrefixRun" Text="Installs to "/><Run x:Name="BuildLocationRun" Text="%LOCALAPPDATA%\PinyonShift"
                                                                   Foreground="{StaticResource FogBrush}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress and the build log. -->
                <Border x:Name="LogPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Visibility="Collapsed">
                    <Grid Margin="24,18,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ProgressText" Text="0%" FontSize="13"
                                       FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ProgressMessageText" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="1" x:Name="BuildProgress" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,12,0,0"/>
                        <Button Grid.Row="2" x:Name="LogToggleButton" Content="Hide details" HorizontalAlignment="Left"
                                Style="{StaticResource LinkButton}" Margin="-8,10,0,0" Click="LogToggleButton_Click"/>
                        <Border Grid.Row="3" x:Name="LogBox" Background="#0B120E" CornerRadius="10" Margin="0,4,0,0"
                                Height="190">
                            <TextBox x:Name="LogTextBox" BorderThickness="0" Background="Transparent"
                                     FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="14,10"
                                     AutomationProperties.Name="Setup log"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- A caught crash. -->
                <Border x:Name="CrashPanel" Background="#1D1512" BorderBrush="{StaticResource RedBrush}"
                        BorderThickness="1" CornerRadius="14" Visibility="Collapsed" VerticalAlignment="Top"
                        AutomationProperties.Name="Crash report ready">
                    <StackPanel Margin="26,22">
                        <TextBlock Foreground="#E3D3CC" TextWrapping="Wrap" LineHeight="21" FontSize="14"
                                   Text="A privacy-safe diagnostic ZIP is ready. Report crash opens a prefilled GitHub issue and selects the ZIP to attach. It holds no game files, saves, generated code or memory dump."/>
                        <TextBlock Margin="0,14,0,0" FontSize="12.5" Foreground="#C8B7AF">
                            <Run Text="Crash ID "/><Run x:Name="CrashIdRun" Text="pscrash-v1-pending"
                                                       FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource FogBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="DlcPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Downloadable content">
                    <StackPanel Margin="26,22">
                        <TextBlock Margin="0,0,0,16" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Import your own FH1 packages, folders or ZIPs. Imports start disabled. Gameplay support, including Rally on the base disc, is still being verified."/>
                        <TextBlock x:Name="DlcEmptyText" Text="No DLC imported for this installation." FontSize="14" Margin="0,8,0,16"/>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="DlcList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ToggleText}" Tag="{Binding}"
                                                    IsEnabled="{Binding CanToggle}" Style="{StaticResource QuietButton}"
                                                    AutomationProperties.Name="{Binding ToggleAccessibleName}"
                                                    AutomationProperties.HelpText="{Binding StatusText}"
                                                    MinWidth="88" VerticalAlignment="Center" Click="ToggleDlcButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="DlcStatusText" Margin="0,8,0,14" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                        <WrapPanel x:Name="DlcControls">
                            <Button Content="Import package or ZIP" Style="{StaticResource ActionButton}" Click="ImportDlcButton_Click" Margin="0,0,10,8"/>
                            <Button Content="Import folder" Style="{StaticResource QuietButton}" Click="ImportDlcFolderButton_Click" Margin="0,0,10,8"/>
                            <Button Content="Done" Style="{StaticResource QuietButton}" Click="CloseDlcButton_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <!-- Optional FH1 v4 title update (TITLE_UPDATE_V4_BACKLOG TU-2). -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="FH1 title update v4" FontSize="14"/>
                                <TextBlock x:Name="TitleUpdateStatusText" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Text="Checking…"
                                           Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                                <CheckBox x:Name="TitleUpdateClubCheckBox" Margin="0,5,0,0" FontSize="12" IsEnabled="False"
                                          Click="TitleUpdateClubCheckBox_Click"
                                          AutomationProperties.Name="Play 1000 Club offline with title update v4">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FogBrush}">
                                        <Run Text="1000 Club offline"/><Run Foreground="{StaticResource MutedBrush}"
                                             Text=" · Goals are confirmed locally instead of by the closed Forza server."/>
                                    </TextBlock>
                                </CheckBox>
                            </StackPanel>
                            <StackPanel x:Name="TitleUpdateControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Import update" Style="{StaticResource QuietButton}"
                                        Click="ImportTitleUpdateButton_Click" Margin="0,0,10,0"
                                        AutomationProperties.Name="Import FH1 title update v4"/>
                                <Button x:Name="TitleUpdateToggleButton" Content="Use v4" Style="{StaticResource QuietButton}"
                                        Click="TitleUpdateToggleButton_Click" IsEnabled="False" MinWidth="88"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Android (ONE_CLICK_SETUP_BACKLOG A-2 to A-5): the package, where it is,
                     and installing it with the game files over Wi-Fi or USB. -->
                <Border x:Name="AndroidPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Android">
                    <Grid Margin="26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Android package" FontSize="14"/>
                            <TextBlock x:Name="AndroidApkText" Margin="0,3,0,10" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Text="Not built yet."/>
                            <WrapPanel>
                                <Button x:Name="AndroidBuildButton" Content="Build APK" Style="{StaticResource ActionButton}"
                                        Click="AndroidBuildButton_Click" Margin="0,0,10,8"
                                        AutomationProperties.HelpText="Build the Android package from this PC's game build."/>
                                <Button x:Name="AndroidShowButton" Content="Show in folder" Style="{StaticResource QuietButton}"
                                        Click="AndroidShowButton_Click" Margin="0,0,10,8"/>
                                <Button x:Name="AndroidSaveButton" Content="Save a copy…" Style="{StaticResource QuietButton}"
                                        Click="AndroidSaveButton_Click" Margin="0,0,0,8"
                                        AutomationProperties.HelpText="Copy the Android package to a folder you choose."/>
                            </WrapPanel>
                            <TextBlock Text="Install over Wi-Fi" FontSize="14" Margin="0,14,0,0"/>
                            <TextBlock x:Name="AndroidShareText" Margin="0,3,0,8" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="No USB cable or developer options: share on Wi-Fi, scan the code with the device's camera and install the app. When it opens, it finds this PC and copies the game files, the v4 update, DLC and Rally data."/>
                            <TextBlock x:Name="AndroidCodeText" Visibility="Collapsed" Margin="0,0,0,8" FontSize="13"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <WrapPanel>
                                <Button x:Name="AndroidShareButton" Content="Share on Wi-Fi" Style="{StaticResource ActionButton}"
                                        Click="AndroidShareButton_Click" Margin="0,0,10,8"/>
                                <Button x:Name="AndroidUsbButton" Content="Install over USB" Style="{StaticResource QuietButton}"
                                        Click="AndroidUsbButton_Click" Margin="0,0,10,8" Visibility="Collapsed"
                                        AutomationProperties.HelpText="For a device with USB debugging on: install the app and copy the game with adb."/>
                                <Button Content="Done" Style="{StaticResource QuietButton}" Click="CloseAndroidButton_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="AndroidStatusText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <StackPanel x:Name="AndroidQrPanel" Grid.Column="1" Margin="22,0,0,0" Visibility="Collapsed"
                                    VerticalAlignment="Top">
                            <Border Background="White" CornerRadius="10" Padding="6">
                                <Image x:Name="AndroidQrImage" Width="196" Height="196"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       AutomationProperties.Name="QR code with the download link for the Android app"/>
                            </Border>
                            <TextBlock Text="Scan with the device's camera" FontSize="12" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Graphics settings read before the game starts. -->
                <Border x:Name="GraphicsPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        Visibility="Collapsed" VerticalAlignment="Top" AutomationProperties.Name="Graphics settings">
                    <Grid Margin="26,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graphics API" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Row="1" Text="Vulkan" Margin="0,8,0,0" VerticalAlignment="Center"
                                   FontSize="16" AutomationProperties.Name="Graphics API: Vulkan"/>
                        <TextBlock Grid.Column="2" Text="Internal resolution" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="ResolutionComboBox" Margin="0,8,0,0" SelectedIndex="0"
                                  AutomationProperties.Name="Internal resolution"
                                  SelectionChanged="GraphicsChoice_SelectionChanged">
                            <ComboBoxItem Tag="1">1×</ComboBoxItem>
                            <ComboBoxItem Tag="2">2×</ComboBoxItem>
                            <ComboBoxItem Tag="3">3×</ComboBoxItem>
                            <ComboBoxItem Tag="4">4×</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="Output scaling" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox Grid.Row="1" Grid.Column="4" x:Name="OutputScalingComboBox" Margin="0,8,0,0" SelectedIndex="0"
                                  AutomationProperties.Name="Output scaling"
                                  SelectionChanged="GraphicsChoice_SelectionChanged">
                            <ComboBoxItem Tag="bilinear">Bilinear</ComboBoxItem>
                            <ComboBoxItem Tag="cas">CAS sharpening</ComboBoxItem>
                            <ComboBoxItem Tag="fsr">FSR 1</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="5" x:Name="ResolutionLineText" Margin="0,14,0,0"
                                   FontSize="13.5" Foreground="{StaticResource FogBrush}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <!-- LS-1.7: what this PC has and the in-game preset that suits it. -->
                        <DockPanel Grid.Row="3" Grid.ColumnSpan="5" Margin="0,20,0,0">
                            <Button DockPanel.Dock="Right" x:Name="UseRecommendedButton" Style="{StaticResource QuietButton}"
                                    Content="Use recommended" VerticalAlignment="Center" Margin="16,0,0,0"
                                    IsEnabled="False" Click="UseRecommendedButton_Click"/>
                            <StackPanel>
                                <TextBlock Text="This PC" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="HardwareText" Margin="0,6,0,0" FontSize="13.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource FogBrush}" Text="Checking the graphics card…"/>
                                <TextBlock x:Name="RecommendationText" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="5" x:Name="TreasureMapCheckBox" Margin="0,20,0,0"
                                  FontFamily="Bahnschrift" FontSize="13" IsChecked="True"
                                  AutomationProperties.Name="Treasure Map">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FogBrush}">
                                <Run Text="Treasure Map"/><Run Foreground="{StaticResource MutedBrush}"
                                     Text=" · Every discount sign and barn find on the map. Once applied, it stays with that save."/>
                            </TextBlock>
                        </CheckBox>
                        <DockPanel Grid.Row="5" Grid.ColumnSpan="5" Margin="0,22,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RestoreGraphicsButton" Content="Restore backup" Style="{StaticResource LinkButton}"
                                        VerticalAlignment="Center" Click="RestoreGraphicsButton_Click"/>
                                <Button x:Name="ResetGraphicsButton" Content="Reset to defaults" Style="{StaticResource LinkButton}"
                                        VerticalAlignment="Center" Margin="4,0,14,0" Click="ResetGraphicsButton_Click"/>
                                <Button Content="Cancel" Style="{StaticResource QuietButton}" Margin="0,0,10,0"
                                        Click="CloseGraphicsButton_Click"/>
                                <Button x:Name="SaveGraphicsButton" Content="Save" Style="{StaticResource ActionButton}"
                                        MinWidth="96" Click="SaveGraphicsButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="GraphicsStatusText" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       Margin="0,0,18,0" AutomationProperties.LiveSetting="Polite"
                                       Text="Everything else is in the game: press F6 while playing."/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            </StackPanel>

            <!-- Footer. -->
            <DockPanel Grid.Row="2" Margin="46,0,46,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource FaintBrush}">
                    <Run x:Name="VersionRun" Text="Pinyon Shift"/><Run Text=" · Not affiliated with Microsoft or Playground Games"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenStateFolderButton" Content="Saves" Style="{StaticResource LinkButton}"
                            Visibility="Collapsed" Click="OpenStateFolderButton_Click"
                            AutomationProperties.HelpText="Open the folder with your saves and settings."/>
                    <Button x:Name="OpenLogsButton" Content="Logs" Style="{StaticResource LinkButton}"
                            Visibility="Collapsed" Click="OpenLogsButton_Click"/>
                    <Button x:Name="ReportProblemButton" Content="Report a problem" Style="{StaticResource LinkButton}"
                            Click="ReportProblemButton_Click"
                            AutomationProperties.HelpText="Open the Pinyon Shift bug report form on GitHub."/>
                    <Button Content="GitHub" Style="{StaticResource LinkButton}"
                            Click="ProjectButton_Click" AutomationProperties.HelpText="Open the project on GitHub."/>
                    <Button Content="Support" Style="{StaticResource LinkButton}"
                            Click="SupportButton_Click"
                            AutomationProperties.HelpText="Open the optional ways to support development. Pinyon Shift stays free."/>
                </StackPanel>
            </DockPanel>

            <!-- Shown while an .iso is dragged over the window. -->
            <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="#E60A0F0C" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="18" Margin="40">
                    <TextBlock Text="Drop to use this disc image" FontSize="26" FontFamily="Bahnschrift SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
