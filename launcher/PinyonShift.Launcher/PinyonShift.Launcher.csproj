<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PinyonShiftLauncher</AssemblyName>
    <RootNamespace>PinyonShift.Launcher</RootNamespace>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>Pinyon Shift Launcher</Product>
    <Description>Builds Pinyon Shift locally from a verified user-supplied game disc image.</Description>
    <Authors>Pinyon Shift contributors</Authors>
    <Copyright>Copyright © 2026 Pinyon Shift contributors</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>Branding\pinyon-shift.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code both launchers share: the updater (FB-10.7) and the Android
         share with its QR code (each launcher draws the QR bitmap itself). -->
    <Compile Include="..\Shared\LauncherUpdate.cs" Link="Shared\LauncherUpdate.cs" />
    <Compile Include="..\Shared\AndroidShare.cs" Link="Shared\AndroidShare.cs" />
    <Compile Include="..\Shared\AndroidShareContent.cs" Link="Shared\AndroidShareContent.cs" />
    <Compile Include="..\Shared\QrCode.cs" Link="Shared\QrCode.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Derived from .github/pinyon-shift-logo.png. -->
    <Resource Include="Branding\pinyon-shift.ico" />
    <Resource Include="Branding\logo-light.png" />
    <Resource Include="Branding\mark-light.png" />
  </ItemGroup>
</Project>
