<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher for Linux (Steam Deck included) and macOS (LX-6, MAC-6).
       Windows keeps the WPF launcher in ../PinyonShift.Launcher. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PinyonShiftLauncher</AssemblyName>
    <RootNamespace>PinyonShift.Launcher.Desktop</RootNamespace>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>Pinyon Shift Launcher</Product>
    <Description>Builds Pinyon Shift locally from a verified user-supplied game disc image.</Description>
    <Authors>Pinyon Shift contributors</Authors>
    <Copyright>Copyright © 2026 Pinyon Shift contributors</Copyright>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Not on macOS: on Apple silicon the precompiled framework code of a
         compressed bundle (inflated into memory) crashed the launcher with
         AccessViolationException in about four of five starts, the first time
         it read a child process's output. Uncompressed: none in 12 starts.
         The release zip compresses the app anyway. -->
    <EnableCompressionInSingleFile Condition="!$(RuntimeIdentifier.StartsWith('osx'))">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Code both launchers share: the updater (FB-10.7) and the Android
         share with its QR code (each launcher draws the QR bitmap itself). -->
    <Compile Include="..\Shared\LauncherUpdate.cs" Link="Shared\LauncherUpdate.cs" />
    <Compile Include="..\Shared\AndroidShare.cs" Link="Shared\AndroidShare.cs" />
    <Compile Include="..\Shared\AndroidShareContent.cs" Link="Shared\AndroidShareContent.cs" />
    <Compile Include="..\Shared\QrCode.cs" Link="Shared\QrCode.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same art as the Windows launcher. -->
    <AvaloniaResource Include="..\PinyonShift.Launcher\Branding\logo-light.png" Link="Branding\logo-light.png" />
    <AvaloniaResource Include="..\PinyonShift.Launcher\Branding\mark-light.png" Link="Branding\mark-light.png" />
  </ItemGroup>
</Project>
